# -- server ------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
# Override where generated links point (behind a reverse proxy):
# PUBLIC_BASE_URL=http://192.168.1.50:3000
# Honor X-Forwarded-Proto/Host from a reverse proxy (Caddy/nginx/Traefik)
TRUST_PROXY=false

# -- secrets -----------------------------------------------------------------
# HMAC secret for signed proxy URLs. Leave unset to auto-generate + persist
# to ./data/secret on first start. Docker secrets: PROXY_SECRET_FILE=/run/secrets/x
# PROXY_SECRET=
# Optional global auth for UI/API/playlist (header, x-auth-token, or ?token=)
# AUTH_TOKEN=
# Docker secrets: AUTH_TOKEN_FILE=/run/secrets/x

# -- share tokens ------------------------------------------------------------
# Per-channel share token TTL in seconds; 0 = non-expiring (LAN use)
SHARE_TOKEN_TTL=0
# Require a valid per-channel token on /live and /stream
SHARE_TOKEN_REQUIRED=false

# -- caching -----------------------------------------------------------------
# Live playlists are short-cached (segment tokens rotate fast); VOD longer
CACHE_TTL_PLAYLIST_MS=1000
CACHE_TTL_VOD_MS=60000
PLAYLIST_CACHE_MAX=256
# Optional micro-cache for decoded/buffered segments (0 = off). 10-20s works
# well; a retrying player then does not re-hit the CDN for dead URLs.
SEG_CACHE_TTL_MS=0
SEG_CACHE_MAX_MB=256

# -- upstream HTTP -----------------------------------------------------------
REQUEST_TIMEOUT_MS=15000
CONNECT_TIMEOUT_MS=5000
MAX_RETRIES=2
MAX_REDIRECTS=8
# Block loopback/private/link-local upstreams (SSRF guard). Set true only if
# an upstream really lives on your LAN / in another container.
ALLOW_PRIVATE_UPSTREAMS=false
# Comma-separated host substrings that must NEVER receive Referer/Origin
# (TikTok CDN 403s any request carrying a Referer)
STRIP_REFERER_HOSTS=tiktokcdn
# Default browser UA sent when a channel defines none
USER_AGENT=Mozilla/5.0 (X11; Linux x86_64; rv:130.0) Gecko/20100101 Firefox/130.0
# Caps (playlists/keys are fully read; wrapped segments are buffered to decode)
UPSTREAM_MAX_BODY_MB=8
UNWRAP_MAX_BUFFER_MB=64

# -- resolvers ---------------------------------------------------------------
RESOLVE_TTL_MS=300000
RESOLVE_TIMEOUT_MS=10000

# -- storage / logging -------------------------------------------------------
DATA_DIR=./data
# CHANNELS_FILE=./data/channels.json
LOG_LEVEL=info
TZ=America/Cayman
