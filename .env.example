# iptv-stream-proxy — environment reference
# Copy to `.env` (next to docker-compose.yml) and set what you need.
# Compose reads this file automatically; empty values mean "not configured".

# ── networking ────────────────────────────────────────────────────────────────
# Host port of the web UI / API (the container always listens on 3000).
HOST_PORT=3009

# Public origin for generated M3U/share links when behind a reverse proxy.
# Leave empty for LAN use (links follow the request Host header).
# PUBLIC_BASE_URL=https://tv.example.com

# Set to true when behind the "caddy" compose profile or any reverse proxy,
# so X-Forwarded-Proto/Host are honored when building playlist URLs.
# TRUST_PROXY=false

# ── auth ──────────────────────────────────────────────────────────────────────
# Optional global token. Guards the web UI API, /api/*, /playlist* and channel
# stream entry points. Accepted via Authorization: Bearer, x-auth-token header
# or ?token= query (what IPTV players need). The web UI asks for it on first
# visit and remembers it.
# AUTH_TOKEN=change-me-to-a-long-random-string

# Per-channel share token lifetime in seconds (0 = non-expiring).
# SHARE_TOKEN_TTL=0

# Require a share token on every /stream/:id and /live/:id URL.
# SHARE_TOKEN_REQUIRED=false

# HMAC secret that signs /proxy/* URLs. Generated and persisted to
# data/secret on first start if unset — leave empty unless rotating.
# PROXY_SECRET=

# ── upstream policy ───────────────────────────────────────────────────────────
# Allow upstreams on private/loopback ranges (LAN IPTV gateways). Keep false
# unless you need it — it weakens the SSRF guard.
# ALLOW_PRIVATE_UPSTREAMS=false

# Re-enable importing the dead t247-/cv- upstream families (they 404/410
# today and only clutter the UI). Skipped by default.
# ALLOW_DEAD_SOURCES=false

# User-Agent sent to upstreams when the channel defines none.
# USER_AGENT=Mozilla/5.0 (X11; Linux x86_64; rv:130.0) Gecko/20100101 Firefox/130.0

# Comma-separated host fragments whose Referer/Origin headers are stripped
# upstream (TikTok CDN 403s on Referer).
# STRIP_REFERER_HOSTS=tiktokcdn

# ── channel bootstrap (startup auto-import) ───────────────────────────────────
# The app imports its channel list from this source at startup, so a fresh
# install shows the live sportsbite catalog (~360 channels) instead of the 3
# example channels. Accepts the same inputs as POST /api import: the
# sportsbite catalog JSON, any M3U/M3U8 playlist URL, or a channels JSON array.
# Set to "off" to disable auto-import (e.g. you bind-mount your own list).
# CHANNELS_IMPORT_URL=https://sportsbite.org/channels

# once    = import on first start and whenever the URL changes (default; your
#           later edits to data/channels.json are kept)
# always  = import at every start (catalog stays authoritative)
# off     = never import
# CHANNELS_IMPORT_MODE=once

# auto  = replace the list only while channels.json is still the untouched
#         example seed; merge into any user-authored list (default)
# true  = always replace; false = always merge
# CHANNELS_IMPORT_REPLACE=auto

# ── performance knobs (defaults are sane) ─────────────────────────────────────
# Playlist cache: 1s TTL for live, 60s for VOD, max 256 entries.
# CACHE_TTL_PLAYLIST_MS=1000
# CACHE_TTL_VOD_MS=60000
# PLAYLIST_CACHE_MAX=256

# Fully-buffered segment cache (decoded image-wrapped TS). 0 TTL disables it.
# SEG_CACHE_TTL_MS=0
# SEG_CACHE_MAX_MB=256

# Upstream request budgets.
# REQUEST_TIMEOUT_MS=15000
# CONNECT_TIMEOUT_MS=5000
# MAX_RETRIES=2
# MAX_REDIRECTS=8
# RESOLVE_TTL_MS=300000
# RESOLVE_TIMEOUT_MS=10000
# UPSTREAM_MAX_BODY_MB=8
# UNWRAP_MAX_BUFFER_MB=64

# ── status checks ─────────────────────────────────────────────────────────────
# Parallelism + timeout for channel probes (UI "Check status" / POST /api/check).
# CHECK_CONCURRENCY=4
# CHECK_TIMEOUT_MS=8000

# ── operations ────────────────────────────────────────────────────────────────
# fatal | error | warn | info | debug | trace
# LOG_LEVEL=info
# TZ=UTC
# DATA_DIR=/app/data            (set inside the container by compose)

# Container user the SERVER runs as. The entrypoint starts briefly as root to
# fix ./data ownership on startup (no manual chown needed), then drops to
# this uid/gid. 1000 = the image's built-in `node` user. Override on hosts
# where your user has a different uid (NAS boxes often use 1026 etc.).
# PUID=1000
# PGID=1000
